generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

enum Role {
  VOTER
  CONTESTANT
  ADMIN
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ElectionStatus {
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

enum PaymentType {
  VOTE_PURCHASE  
}

enum PaymentStatus {
  COMPLETED
  FAILED
}

enum NotifType {
  VOTE_CONFIRMED
  ELECTION_REMINDER
  ELECTION_RESULT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  CANDIDACY_UPDATE
  SYSTEM_ALERT
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  role               Role                @default(VOTER)
  isVerified         Boolean             @default(false)
  isActive           Boolean             @default(true)
  googleId           String?             @unique
  twoFactorEnabled   Boolean             @default(false)
  anonymousMode      Boolean             @default(true)
  votes              Vote[]
  notifications      Notification[]
  bookmarks          Bookmark[]
  payments           Payment[]
  auditLogs          AuditLog[]
  candidates         Candidate[]
  createdCandidates Candidate[] @relation("AdminAddedCandidates")
  paymentIntents     PaymentIntent[]     
  verificationTokens VerificationToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Candidate {
  id              String          @id @default(uuid())
  userId          String          
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByAdminId String?         
  createdByAdmin   User?           @relation("AdminAddedCandidates", fields: [createdByAdminId], references: [id])
  avatarUrl       String?
  electionId      String
  election        Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateNumber String?
  party           String?
  slogan          String?
  bio             String?
  manifesto       String?
  bannerUrl       String?
  websiteUrl      String?
  twitterHandle   String?
  instagramHandle String?
  status          CandidateStatus @default(PENDING)
  votesReceived   Int             @default(0)
  votes           Vote[]
  payments        Payment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@unique([electionId, candidateNumber])
}

model Election {
  id              String         @id @default(uuid())
  title           String
  description     String?
  category        String
  startDate       DateTime
  endDate         DateTime
  status          ElectionStatus @default(UPCOMING)
  maxCandidates   Int            @default(10)
  totalVotes      Int            @default(0)
  maxVoters       Int?
  maxVotesPerUser  Int            @default(1)
  votePrice       Int            @default(100)
  rules           String?
  organizerName   String?
  organizerEmail  String?
  organizerPhone  String?
  bannerUrl       String? 
  createdBy       String
  resultsPublishedAt DateTime? 
  candidates      Candidate[]
  votes           Vote[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookmarks       Bookmark[]
}

model Vote {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  electionId  String
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  isAnonymous Boolean   @default(true)
  txHash      String?   @unique
  votedAt     DateTime  @default(now())
  paymentId   String?   @unique
  payment     Payment?  @relation(fields: [paymentId], references: [id])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId           String?
  candidate             Candidate?    @relation(fields: [candidateId], references: [id])
  amount                Float
  currency              String        @default("USD")
  type                  PaymentType
  status                PaymentStatus @default(COMPLETED)
  stripePaymentIntentId String?       @unique
  receiptUrl            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  votes                 Vote[]
}

model PaymentIntent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pidx          String?  @unique
  transactionId String?  @unique
  electionId    String
  candidateId   String
  quantity      Int
  amount        Int
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([pidx])
  @@index([status])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotifType
  isRead    Boolean   @default(false)
  link      String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  details   String?
  ipAddress String?
  result    String   @default("OK")
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])   
  token     String    @unique
  type      TokenType
  metadata  String?
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model ElectionRequest {
  id           String   @id @default(uuid())
  name         String?
  email        String
  phone        String?
  organization String?
  message      String
  status       String   @default("PENDING")  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, electionId])
}

